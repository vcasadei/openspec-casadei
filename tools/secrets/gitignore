# Local environment files. Commit only .env.example, with placeholder values.
.env
.env.*
!.env.example

# Private keys, certificates, and keystores. To commit a public certificate
# on purpose, add a `!path/to/cert.pem` line after this block.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*

# Cloud and tool credential files.
.aws/credentials
*.kubeconfig
.netrc
.pgpass
